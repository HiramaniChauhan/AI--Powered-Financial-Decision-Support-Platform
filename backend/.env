# Switch to PostgreSQL when Docker is running:
# DATABASE_URL=postgresql+asyncpg://finmem:finmem@localhost:5432/finmemx
# DATABASE_SYNC_URL=postgresql://finmem:finmem@localhost:5432/finmemx
DATABASE_URL=sqlite+aiosqlite:///./finmemx.db
DATABASE_SYNC_URL=sqlite:///./finmemx.db
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
JWT_SECRET_KEY=finmem-x-dev-secret-key
DEBUG=true
